# Copie para deploy/.env e troque a senha (ex.: openssl rand -hex 24)
POSTGRES_PASSWORD=troque-esta-senha
JWT_SIGNING_KEY=gere-uma-chave-aleatoria-com-ao-menos-32-bytes
ASPNETCORE_ENVIRONMENT=Production
HTTP_PORT=80
# SMTP para convites e recuperação de senha (ex.: Amazon SES em email-smtp.<regiao>.amazonaws.com)
EMAIL_HOST=smtp.exemplo.com
EMAIL_PORT=587
EMAIL_SEGURANCA=StartTls
EMAIL_USUARIO=
EMAIL_SENHA=
EMAIL_REMETENTE=nao-responda@exemplo.com
