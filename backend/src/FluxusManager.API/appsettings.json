{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "MigrateOnStartup": true
  },
  "Filiais": {
    "ValidarRaizCnpjDaEmpresa": true
  },
  "Jwt": {
    "Issuer": "FluxusManager",
    "Audience": "FluxusManager",
    "AccessTokenMinutes": 15
  },
  "RefreshTokens": {
    "DuracaoDias": 7,
    "LimpezaHabilitada": true
  },
  "Login": {
    "MaxTentativas": 5,
    "BloqueioMinutos": 15
  },
  "RateLimiting": {
    "RequisicoesPorMinuto": 20
  },
  "Proxy": {
    "Confiavel": false
  },
  "Frontend": {
    "Url": ""
  },
  "Convites": {
    "ValidadeHoras": 72
  },
  "Email": {
    "Host": "",
    "Port": 587,
    "Seguranca": "StartTls",
    "RemetenteEmail": "",
    "RemetenteNome": "FluxusManager",
    "TimeoutSegundos": 30
  }
}
